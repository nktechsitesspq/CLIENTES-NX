function showToast(msg,error=false){const t=$("toast");t.textContent=msg;t.className="toast show"+(error?" error":"");setTimeout(()=>t.className="toast",3000)}
function digits(v){return (v||"").replace(/\D/g,"")}
function maskPhone(v){
  const d=digits(v).slice(0,11);
  if(!d) return "";
  if(d.length<=2) return "("+d;
  if(d.length<=7) return "("+d.slice(0,2)+") "+d.slice(2);
  return "("+d.slice(0,2)+") "+d.slice(2,7)+"-"+d.slice(7);
}

function maskCEP(v){
  const d=digits(v).slice(0,8);
  return d.replace(/(\d{5})(\d{0,3})/,'$1-$2').replace(/-$/,'');
}
function maskDate(v){
  const d=digits(v).slice(0,8);
  return d.replace(/(\d{2})(\d{2})(\d{0,4})/,'$1/$2/$3').replace(/[\/]$/,'');
}

function maskCPF(v){
  const d=digits(v).slice(0,11);
  if(!d) return "";
  if(d.length<=3) return d;
  if(d.length<=6) return d.slice(0,3)+"."+d.slice(3);
  if(d.length<=9) return d.slice(0,3)+"."+d.slice(3,6)+"."+d.slice(6);
  return d.slice(0,3)+"."+d.slice(3,6)+"."+d.slice(6,9)+"-"+d.slice(9);
}
function parseMoney(v){return Number(digits(v))/100}
function formatInputMoney(v){const n=parseMoney(v);return n?new Intl.NumberFormat("pt-BR",{minimumFractionDigits:2,maximumFractionDigits:2}).format(n):""}
function calculate(){
 const amount=parseMoney($("amount").value);
 let rate=0;
 if(amount>=50&&amount<=99.99)rate=40;
 else if(amount>=100&&amount<=300)rate=30;
 const interest=amount*rate/100,total=amount+interest;
 $("rate").textContent=rate+"%";$("interest").textContent=BRL.format(interest);$("total").textContent=BRL.format(total);
 $("rateInfo").textContent=rate?`Para ${BRL.format(amount)}, os juros são de ${rate}% e o total é ${BRL.format(total)}.`:"Digite um valor válido entre R$ 50,00 e R$ 300,00.";
 if($("summaryAmount"))$("summaryAmount").textContent=BRL.format(amount);
 if($("summaryRate"))$("summaryRate").textContent=rate+"%";
 if($("summaryTotal"))$("summaryTotal").textContent=BRL.format(total);
 return {amount,rate,interest,total};
}




function formatCountdown(ms){
  const total=Math.max(0,Math.ceil(ms/1000));
  const h=String(Math.floor(total/3600)).padStart(2,"0");
  const m=String(Math.floor((total%3600)/60)).padStart(2,"0");
  const s=String(total%60).padStart(2,"0");
  return `${h}:${m}:${s}`;
}
function stopCooldown(){
  if(cooldownTimer){clearInterval(cooldownTimer);cooldownTimer=null}
}
function applyCooldownState(){
  const remaining=(lastRequestAt+3600000)-Date.now();
  const locked=remaining>0;
  $("cooldownCard").classList.toggle("show",locked);
  $("requestCard").classList.toggle("cooldown-locked",locked);
  $("confirmationCard").classList.toggle("cooldown-locked",locked);
  $("submit").disabled=locked;
  if(locked){
    $("cooldownTime").textContent=formatCountdown(remaining);
    $("submit").textContent="AGUARDE PARA SOLICITAR NOVAMENTE";
    if(currentMode==="new" || (currentMode==="login" && currentClientId && loggedClient)){
      $("submit").style.display="block";
    }else{
      $("submit").style.display="none";
    }
  }else{
    $("cooldownTime").textContent="00:00:00";
    $("submit").textContent=currentMode==="new"?"FINALIZAR CADASTRO":"ENVIAR SOLICITAÇÃO";
    stopCooldown();
    if(currentMode==="new"){
      $("submit").style.display="block";
      $("submit").disabled=false;
    }else{
      updateSubmitVisibility();
    }
  }
}
function startCooldown(){
  stopCooldown();
  applyCooldownState();
  if((lastRequestAt+3600000)>Date.now()){
    cooldownTimer=setInterval(applyCooldownState,1000);
  }
}
async function loadLastRequestForClient(clientId){
  lastRequestAt=0;
  if(!db||!fs||!clientId){startCooldown();return}
  try{
    const q=fs.query(
      fs.collection(db,"loanRequests"),
      fs.where("clientId","==",clientId)
    );
    const snap=await fs.getDocs(q);
    snap.forEach(d=>{
      const data=d.data();
      const created=Number(data.createdAt)||0;
      if(created>lastRequestAt)lastRequestAt=created;
    });
  }catch(err){
    console.error("[COOLDOWN]",err);
  }
  startCooldown();
}

function updateSubmitVisibility(){
  if(currentMode!=="login" || !currentClientId || !loggedClient){
    if(currentMode==="login"){
      $("submit").style.display="none";
      $("submit").disabled=true;
    }
    return;
  }
  const amount=parseMoney($("amount").value);
  const pixType=String($("pixType").value||"").trim();
  const pix=String($("pix").value||"").trim();
  const consent=!!$("consent").checked;
  const ready=amount>=50 && amount<=300 && !!pixType && !!pix && consent;
  const remaining=(lastRequestAt+3600000)-Date.now();
  const blocked=remaining>0;
  $("submit").style.display=ready?"block":"none";
  $("submit").disabled=!ready || blocked;
  if(!blocked) $("submit").textContent="ENVIAR SOLICITAÇÃO";
}

function setFlowUI(mode){
  const registering=mode==="new";
  // No login, nada da solicitação aparece antes da identificação correta.
  const identified=!registering && !!currentClientId && !!loggedClient;

  $("personalDataCard").style.display=registering?"block":(identified?"block":"none");
  if(registering){$("cooldownCard").classList.remove("show");stopCooldown();lastRequestAt=0;}
  $("requestCard").style.display=identified?"block":"none";
  $("confirmationCard").style.display=identified?"block":"none";
  $("submit").textContent=registering?"FINALIZAR CADASTRO":"ENVIAR SOLICITAÇÃO";
  $("submit").style.display=registering?"block":(identified?"none":"none");
  $("submit").disabled=!registering && !identified;
  const security=document.querySelector(".security");
  const notice=document.querySelector(".notice");
  if(security)security.style.display=identified?"flex":"none";
  if(notice)notice.style.display=identified?"block":"none";
  if(identified) updateSubmitVisibility();
}
function validEmail(value){
  return !value || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
}
function validateRegistration(){
  const required=[
    ["name","Informe o nome completo."],
    ["phone","Informe o WhatsApp."],
    ["cpf","Informe os 11 números do CPF."],
    ["address","Informe o endereço completo."]
  ];
  for(const [id,msg] of required){
    const el=$(id);
    if(!el || !el.value.trim()){
      showToast(msg,true);
      if(el)el.focus();
      return false;
    }
  }
  if(digits($("cpf").value).length!==11){
    showToast("Digite os 11 números do CPF.",true);
    $("cpf").focus();
    return false;
  }
  if(digits($("phone").value).length<10){
    showToast("Digite um telefone válido.",true);
    $("phone").focus();
    return false;
  }
  if(!validEmail($("email").value.trim())){
    showToast("Digite um e-mail válido.",true);
    $("email").focus();
    return false;
  }
  if(!$("registerConsent").checked){
    showToast("Marque a autorização para finalizar o cadastro.",true);
    $("registerConsent").focus();
    return false;
  }
  return true;
}
function validateRequest(){
  const remaining=(lastRequestAt+3600000)-Date.now();
  if(remaining>0){
    showToast("Aguarde "+formatCountdown(remaining)+" para fazer outra solicitação.",true);
    startCooldown();
    return null;
  }
  const calc=calculate();
  if(calc.amount<50||calc.amount>300){
    showToast("O valor deve ser entre R$ 50,00 e R$ 300,00.",true);
    $("amount").focus();
    return null;
  }
  if(!$("pixType").value){
    showToast("Escolha o tipo da chave PIX.",true);
    $("pixType").focus();
    return null;
  }
  if(!$("pix").value.trim()){
    showToast("Informe a chave PIX.",true);
    $("pix").focus();
    return null;
  }
  if(!$("consent").checked){
    showToast("Marque a autorização para enviar a solicitação.",true);
    $("consent").focus();
    return null;
  }
  return calc;
}

