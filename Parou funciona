function updatePixKeyboard(){
  const type=$("pixType").value;
  const input=$("pix");
  const numeric=type==="CPF"||type==="Telefone";
  input.setAttribute("inputmode",numeric?"numeric":"text");
  input.setAttribute("type",numeric?"tel":"text");
  input.setAttribute("autocomplete","off");
  input.value="";

  if(type==="CPF"){
    input.placeholder="Digite os 11 números do CPF";
    input.maxLength=14;
  }else if(type==="Telefone"){
    input.placeholder="Digite o número do telefone";
    input.maxLength=15;
  }else if(type==="E-mail"){
    input.setAttribute("type","email");
    input.setAttribute("inputmode","email");
    input.placeholder="Digite o e-mail da chave PIX";
    input.removeAttribute("maxlength");
  }else{
    input.placeholder="Digite sua chave PIX";
    input.removeAttribute("maxlength");
  }
}

