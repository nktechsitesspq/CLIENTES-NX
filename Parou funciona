$("form").onsubmit=async e=>{
  e.preventDefault();

  if(!db||!fs){
    showToast("Firebase ainda não conectou. Aguarde e tente novamente.",true);
    return;
  }

  const btn=$("submit");
  btn.disabled=true;

  try{
    const now=Date.now();

    // ETAPA 1: criar a conta, sem gerar empréstimo.
    if(currentMode==="new"){
      if(!validateRegistration()){
        btn.disabled=false;
        btn.textContent="FINALIZAR CADASTRO";
        return;
      }

      btn.textContent="FINALIZANDO...";
      const cpfValue=maskCPF($("cpf").value);
      const phoneValue=maskPhone($("phone").value);
      const phoneKey=digits(phoneValue);
      const alreadyExists=await checkExistingCpf(false);

      if(alreadyExists){
        showToast("Este CPF já possui conta. Entre em Já sou cliente.",true);
        btn.disabled=false;
        btn.textContent="FINALIZAR CADASTRO";
        $("cpf").scrollIntoView({behavior:"smooth",block:"center"});
        return;
      }

      const phoneAlreadyExists=await checkExistingPhone(false);
      if(phoneAlreadyExists){
        showToast("Este número de telefone já possui conta. Use Já sou cliente.",true);
        btn.disabled=false;
        btn.textContent="FINALIZAR CADASTRO";
        $("phone").scrollIntoView({behavior:"smooth",block:"center"});
        return;
      }

      // O CPF continua sendo o ID principal. O telefone também recebe uma
      // chave normalizada (phoneId) e é tratado como identificador único.
      // Isso evita que duas submissões concorrentes criem duas contas para o mesmo CPF.
      const clientIdKey=digits(cpfValue);
      const clientRef=fs.doc(db,"clients",clientIdKey);
      const clientId=clientRef.id;
      const name=$("name").value.trim();

      const client={
        name,
        phone:phoneValue,
        phoneId:phoneKey,
        phone2:"",
        cpf:cpfValue,
        address:$("address").value.trim(),
        email:$("email").value.trim(),
        notes:"",
        photo:"",
        pix:"",
        pixType:"",
        source:"client_form",
        status:"active",
        createdAt:now,
        updatedAt:now
      };

      // O ID do documento é o CPF normalizado. Assim o mesmo CPF aponta
      // sempre para a mesma conta e não precisamos de uma transação (que
      // exige permissão de leitura além da permissão de criação).
      try{
        const existing=await fs.getDoc(clientRef);
        if(existing.exists()){
          showToast("Este CPF já possui conta. Entre em Já sou cliente.",true);
          btn.disabled=false;
          btn.textContent="FINALIZAR CADASTRO";
          $("cpf").scrollIntoView({behavior:"smooth",block:"center"});
          return;
        }
      }catch(checkErr){
        // Se a regra do Firestore não permitir leitura, ainda tentamos criar
        // usando o ID determinístico. A própria regra de criação decide.
        console.warn("[CPF CHECK BEFORE CREATE]",checkErr);
      }

      await fs.setDoc(clientRef,client,{merge:false});

      // A notificação é auxiliar. Se as regras do Firestore não permitirem
      // escrita nessa coleção, não devemos impedir o cadastro do cliente.
      try{
        const notifRef=fs.doc(fs.collection(db,"notifications"));
        await fs.setDoc(notifRef,{
          type:"newclient",
          title:"Novo cliente cadastrado",
          text:name+" finalizou o cadastro.",
          clientId,
          createdAt:now,
          read:false
        });
      }catch(notifErr){
        console.warn("[NOTIFICATION CREATE]",notifErr);
      }

      // Depois do cadastro, leva para Já sou cliente.
      const registeredCpf=cpfValue;
      $("form").reset();
      calculate();
      currentClientId="";
      loggedClient=null;
      setMode("login");
      $("loginCpf").value=registeredCpf;
      $("welcomeClient").textContent="Cadastro finalizado! Agora toque em ENTRAR para acessar sua conta e fazer uma solicitação.";
      $("welcomeClient").classList.add("show");
      btn.disabled=false;
      btn.textContent="ENVIAR SOLICITAÇÃO";
      window.scrollTo({top:$("accessCard").offsetTop-12,behavior:"smooth"});
      setTimeout(()=>$("loginBtn").focus(),250);
      return;
    }

    // ETAPA 2: somente um cliente efetivamente identificado pode solicitar.
    if(!currentClientId||!loggedClient){
      showToast("Entre com o CPF antes de solicitar.",true);
      btn.disabled=false;
      btn.textContent="ENVIAR SOLICITAÇÃO";
      setMode("login");
      return;
    }
    const calc=validateRequest();
    if(!calc){
      btn.disabled=false;
      btn.textContent="ENVIAR SOLICITAÇÃO";
      return;
    }
    btn.textContent="ENVIANDO...";
    const name=loggedClient.name||"Cliente";

    await fs.setDoc(fs.doc(db,"clients",currentClientId),{
      pix:$("pix").value.trim(),
      pixType:$("pixType").value,
      updatedAt:now
    },{merge:true});

    const requestRef=fs.doc(fs.collection(db,"loanRequests"));
    await fs.setDoc(requestRef,{
      clientId:currentClientId,
      name,
      phone:loggedClient.phone||"",
      cpf:loggedClient.cpf||"",
      pix:$("pix").value.trim(),
      pixType:$("pixType").value,
      amount:calc.amount,
      ratePct:calc.rate,
      interest:calc.interest,
      total:calc.total,
      status:"pending",
      createdAt:now,
      updatedAt:now
    });

    const notifRef=fs.doc(fs.collection(db,"notifications"));
    await fs.setDoc(notifRef,{
      type:"newrequest",
      title:"Nova solicitação de empréstimo",
      text:name+" solicitou "+BRL.format(calc.amount)+".",
      clientId:currentClientId,
      requestId:requestRef.id,
      createdAt:now,
      read:false
    });

    lastRequestAt=now;
    startCooldown();
    $("form").style.display="none";
    $("successTitle").textContent="Solicitação enviada";
    $("success").classList.add("show");
    $("protocolText").textContent="Protocolo: "+requestRef.id.toUpperCase()+" • Nova solicitação disponível em 1 hora.";

  }catch(err){
    console.error(err);
    showToast("Erro ao salvar. Verifique a conexão e as regras do Firestore.",true);
    btn.disabled=false;
    btn.textContent=currentMode==="new"?"FINALIZAR CADASTRO":"ENVIAR SOLICITAÇÃO";
  }
};
localStorage.removeItem("nx_client_last_cpf");
setFlowUI("new");
setupFirebase();

// PATCH FINAL: máscaras robustas para celular e troca de modo por toque.
(function(){
  function forceMask(el, fn, maxDigits){
    if(!el) return;
    const apply=()=>{
      const raw=digits(el.value).slice(0,maxDigits);
      el.value=fn(raw);
    };
    el.removeAttribute("maxlength");
    el.addEventListener("input", apply, {capture:true});
    el.addEventListener("paste", ()=>setTimeout(apply,0), {capture:true});
    el.addEventListener("keyup", apply, {capture:true});
    apply();
  }
  forceMask($("phone"), maskPhone, 11);
  forceMask($("cpf"), maskCPF, 11);
  forceMask($("loginCpf"), maskCPF, 11);

  function activateMode(mode){
    if(typeof setMode === "function") setMode(mode);
    const btn=mode==="login"?$("modeLogin"):$("modeNew");
    if(btn) btn.blur();
  }
  // pointerup funciona melhor em Android do que depender só de click.
  const newBtn=$("modeNew"), loginBtn=$("modeLogin");
  if(newBtn){
    newBtn.addEventListener("pointerup", e=>{e.preventDefault();e.stopPropagation();activateMode("new")},{capture:true});
    newBtn.addEventListener("touchend", e=>{e.preventDefault();activateMode("new")},{passive:false});
  }
  if(loginBtn){
    loginBtn.addEventListener("pointerup", e=>{e.preventDefault();e.stopPropagation();activateMode("login")},{capture:true});
    loginBtn.addEventListener("touchend", e=>{e.preventDefault();activateMode("login")},{passive:false});
  }

  const name=$("name");
  if(name){
    name.addEventListener("input",()=>{
      const start=name.selectionStart;
      name.value=name.value.toUpperCase();
      try{name.setSelectionRange(start,start)}catch(e){}
    },{capture:true});
  }
})();

// Eventos principais do acesso: ficam dentro do mesmo escopo do módulo Firebase.
// Isso evita que o Android/Chrome tente chamar funções que não são globais.
const modeNewBtn=$("modeNew");
const modeLoginBtn=$("modeLogin");
if(modeNewBtn){
  modeNewBtn.addEventListener("click",e=>{
    e.preventDefault();
    setMode("new");
  });
}
if(modeLoginBtn){
  modeLoginBtn.addEventListener("click",e=>{
    e.preventDefault();
    setMode("login");
    setTimeout(()=>$("loginCpf").focus(),120);
  });
}
const loginButton=$("loginBtn");
if(loginButton){
  loginButton.addEventListener("click",e=>{
    e.preventDefault();
    loginByCpf();
  });
}
const loginCpfInput=$("loginCpf");
if(loginCpfInput){
  loginCpfInput.addEventListener("keydown",e=>{
    if(e.key==="Enter"){
      e.preventDefault();
      loginByCpf();
    }
  });
}

