let firebaseReady=null;
async function setupFirebase(){
 if(db&&fs) return true;
 if(firebaseReady) return firebaseReady;
 firebaseReady=(async()=>{
  try{
   const V="https://www.gstatic.com/firebasejs/10.12.5/";
   const [appMod,fsMod]=await Promise.all([import(V+"firebase-app.js"),import(V+"firebase-firestore.js")]);
   const app=appMod.initializeApp(firebaseConfig);
   db=fsMod.getFirestore(app); fs=fsMod;
   return true;
  }catch(e){
   console.error(e); firebaseReady=null;
   showToast("Não foi possível conectar ao Firebase. Verifique a internet e tente novamente.",true);
   return false;
  }
 })();
 return firebaseReady;
}
