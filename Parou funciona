async function loginByCpf(){
  if(!db||!fs){
    const ok=await setupFirebase();
    if(!ok) return;
  }
  const cpf=maskCPF($("loginCpf").value);
  const cpfDigits=digits(cpf);
  if(cpfDigits.length!==11){
    showToast("Digite os 11 números do CPF.",true);
    $("loginCpf").focus();
    return;
  }

  $("form").classList.add("is-loading");
  $("loginBtn").disabled=true;
  try{
    let docSnap=null;

    // Primeiro tenta o ID novo (CPF somente com números).
    const directRef=fs.doc(db,"clients",cpfDigits);
    const directSnap=await fs.getDoc(directRef);
    if(directSnap.exists()){
      docSnap=directSnap;
    }else{
      // Compatibilidade com cadastros antigos: alguns podem ter CPF formatado
      // e outros podem ter CPF somente com números.
      const values=[cpf,cpfDigits];
      for(const value of values){
        const q=fs.query(
          fs.collection(db,"clients"),
          fs.where("cpf","==",value),
          fs.limit(1)
        );
        const snap=await fs.getDocs(q);
        if(!snap.empty){
          docSnap=snap.docs[0];
          break;
        }
      }
    }

    if(!docSnap){
      showToast("CPF não encontrado. Faça um novo cadastro.",true);
      return;
    }

    fillClientData(docSnap.data(),docSnap.id);
    window.scrollTo({top:$("customerCompact").offsetTop-12,behavior:"smooth"});
  }catch(err){
    console.error("[LOGIN CPF]",err);
    showToast("Não foi possível entrar com este CPF. Verifique a conexão e tente novamente.",true);
  }finally{
    $("form").classList.remove("is-loading");
    $("loginBtn").disabled=false;
  }
}


let cpfCheckTimer=null;
async function checkExistingCpf(showOnlyWhenExists=true){
  if(currentMode!=="new"||!db||!fs) return false;

  const field=$("cpf");
  const alertBox=$("cpfExistsAlert");
  const cpf=maskCPF(field.value);

  field.classList.remove("input-error");
  alertBox.classList.remove("show");

  if(digits(cpf).length!==11) return false;

  try{
    const q=fs.query(
      fs.collection(db,"clients"),
      fs.where("cpf","==",cpf),
      fs.limit(1)
    );
    const snap=await fs.getDocs(q);
    const exists=!snap.empty;

    if(exists){
      field.classList.add("input-error");
      alertBox.classList.add("show");
    }

    return exists;
  }catch(err){
    console.error("[CPF CHECK]",err);
    if(!showOnlyWhenExists) showToast("Não foi possível verificar o CPF.",true);
    return false;
  }
}
async function checkExistingPhone(showOnlyWhenExists=true){
  if(currentMode!=="new"||!db||!fs) return false;

  const phone=maskPhone($("phone").value);
  const phoneKey=digits(phone);
  if(phoneKey.length<10) return false;

  try{
    const [byPhoneId,byPhone]=await Promise.all([
      fs.getDocs(fs.query(fs.collection(db,"clients"),fs.where("phoneId","==",phoneKey),fs.limit(1))),
      fs.getDocs(fs.query(fs.collection(db,"clients"),fs.where("phone","==",phone),fs.limit(1)))
    ]);
    return !byPhoneId.empty || !byPhone.empty;
  }catch(err){
    console.error("[PHONE CHECK]",err);
    if(!showOnlyWhenExists) showToast("Não foi possível verificar o telefone.",true);
    return false;
  }
}
