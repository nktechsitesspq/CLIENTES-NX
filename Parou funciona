<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#050607">
<title>NX Empréstimos — Solicitação</title>
<style>
:root{--bg:#050607;--card:#12151a;--card2:#1a1f27;--line:#2b323d;--text:#f5f7fa;--muted:#9aa4b2;--blue:#ff3038;--green:#25d366;--gold:#ff3038;--red:#ff1f2d}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;position:relative;background:radial-gradient(circle at top,#25070a 0,#090506 38%,#030303 100%);color:var(--text);font-family:Inter,system-ui,Arial,sans-serif}
button,input,select,textarea{font:inherit}
main{max-width:620px;margin:auto;padding:22px 16px 48px}
.brand{text-align:center;padding:24px 0 18px;position:relative}
.logo{width:106px;height:106px;margin:auto;border-radius:50%;display:grid;place-items:center;background:#080808;border:3px solid var(--red);box-shadow:0 0 30px rgba(255,31,45,.22);font-weight:900;font-size:31px;color:var(--gold)}
.brand h1{font-size:22px;margin:14px 0 4px}.brand p{margin:0;color:var(--muted);font-size:13px}
.card{background:linear-gradient(160deg,#1c1114,#100b0d);border:1px solid var(--line);border-radius:30px;padding:18px;margin-bottom:14px;box-shadow:0 12px 30px rgba(0,0,0,.35)}
.title{font-size:17px;font-weight:800;margin:0 0 4px}.sub{font-size:12.5px;color:var(--muted);margin:0 0 16px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:470px){.grid{grid-template-columns:1fr}}
.field{margin-bottom:13px}.field label{display:block;margin-bottom:7px;color:#b8c0cc;font-size:12px;font-weight:800;letter-spacing:.3px}
.input{width:100%;border:1px solid var(--line);border-radius:19px;background:var(--card2);color:var(--text);padding:14px;outline:none}
.input:focus{border-color:var(--blue);box-shadow:0 0 0 4px rgba(255,31,45,.14)}
textarea.input{min-height:92px;resize:vertical}
.money-wrap{position:relative}
.money-input-shell{
  display:flex;
  align-items:center;
  gap:10px;
  width:100%;
  border:1px solid var(--line);
  border-radius:19px;
  background:var(--card2);
  padding:0 14px;
}
.money-prefix{
  display:flex;
  align-items:center;
  justify-content:center;
  height:56px;
  font-weight:900;
  color:#cbd2dc;
  line-height:1;
  flex:none;
}
.money-input-shell input{
  border:0!important;
  background:transparent!important;
  box-shadow:none!important;
  padding:14px 0!important;
  height:56px;
}
.calc{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.calc-box{background:#0d1116;border:1px solid var(--line);border-radius:20px;padding:13px}
.calc-box span{display:block;color:var(--muted);font-size:11px;font-weight:700}.calc-box strong{display:block;margin-top:4px;font-size:21px}
.green{color:var(--red)}.gold{color:var(--gold)}
.rate-info{margin-top:10px;padding:11px 12px;border-radius:18px;background:rgba(255,31,45,.10);border:1px solid rgba(255,31,45,.28);font-size:12.5px;color:#ffc1c6}
.check{display:flex;gap:10px;align-items:flex-start;color:#c4cbd5;font-size:12.5px;line-height:1.45}.check input{margin-top:3px;width:18px;height:18px}
.btn{width:100%;border:0;border-radius:20px;padding:16px;font-size:16px;font-weight:900;color:#fff;background:linear-gradient(180deg,#ff3b45,#c90f1c);box-shadow:0 10px 25px rgba(255,31,45,.28)}
.btn:disabled{opacity:.55}
.notice{font-size:11px;color:#747e8b;line-height:1.55;text-align:center;margin-top:12px}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);width:calc(100% - 32px);max-width:430px;background:#201013;border:1px solid rgba(255,31,45,.45);padding:14px;border-radius:19px;text-align:center;font-weight:800;display:none;z-index:20}.toast.show{display:block}.toast.error{background:#241014;border-color:rgba(239,68,68,.45)}
.success{display:none;text-align:center}.success.show{display:block}.success .ok{width:70px;height:70px;border-radius:50%;display:grid;place-items:center;margin:0 auto 12px;background:rgba(255,31,45,.13);color:var(--red);font-size:36px}
.rules{display:grid;gap:9px}.rule{display:flex;justify-content:space-between;gap:12px;padding:12px;border-radius:18px;background:#0d1116;border:1px solid var(--line)}.rule b{color:var(--gold)}

.hero-note{margin:14px auto 0;max-width:480px;padding:11px 14px;border-radius:19px;background:rgba(255,31,45,.08);border:1px solid rgba(255,31,45,.22);color:#ffb0b6;font-size:12px;line-height:1.45}
.progress { display : flex ;justify-content:center;gap:8px; margin : 10px 0 4px } .progress span { width: 38px ; height: 5px ;border-radius : 999px ;background:#29313d}.progress span.on{background: linear -gradient(90deg,#ff1f2d,#ff6b73)}
.summary - box { display : grid ; grid - template - columns : 1fr 1fr ; gap : 10px }
.summary - boxdiv { background : # 0d1116 ; border : 1px solid var ( -- line ) ; border -radius : 19px ; padding : 13px } 
. resumo - box div : last - child { grid - column : 1/ -1 } 
.summary - box span { display : block ; color : var ( -- muted );font-size : 11px ; font-weight : 700 } .summary - box strong{display: block ; margin -top: 5px ;font-size:19px } 
. s e c u r i t a t y { d i s p l a y : flex;gap:10px;align-items:center;margin-top:12px;color:#8f99a7;font-size:11.5px}
. s e c u r i t y i { f o n t - s t y l e :normal;width:28px;height:28px;border-radius:9px;display:grid;place-items:center;background:rgba(255,31,45,.10);color:var(--red)} 


. marca - logotipo {​​​​​​​
  largura : min (155px, 46vw ) ;
  proporção de aspecto : 1/1 ;​​​​​​​
  altura : automática ;​​​
  exibir : bloco ;​​​​
  margem : 0 auto 10px ;​
  raio da borda : 50 % ;​​​​​​​
  obj ec t - ajuste : capa ;​​​
  c i p - caminho : círculo ( 50%) ;
  filtro : sombra-projetada(0 10px 24px rgba(244,183,64, .25 ) ) ;
  animação : logoFloat 4s ease -in - out infinito ;
}
@ key frames log o Float {​​​​​​​​​​​​​ 
  0 % , 100 % { transformar : translateY ( 0 ) escala ( 1 ) }​
  5 0 % { transform : translateY ( -5px) scale ( 1.02 ) }
}
corpo : antes {​
  conteúdo : "";posição:fixa;inserção:0;eventos-ponteiro:nenhum;índice - z : -1 ;
  fundo :​​​​​​​​​
    r a d i a l - gradiente ( circle a 1 5 % 1 0 % , r g b a ( 2 5 5 , 3 1 , 4 5 , . 0 8 ) , trans p a n s p a r e n t 2 8 % ) ,​​​​​​​​​​​​​    
    radial-gradient(circle at 85% 18%,rgba(255,31,45,.08),transparent 30%);
  animation:bgPulse 7s ease-in-out infinite alternate;
}
@keyframes bgPulse{from{opacity:.65}to{opacity:1}}
.card{
  backdrop-filter:blur(10px);
  animation:cardIn .55s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes cardIn{
  from{opacity:0;transform:translateY(16px) scale(.985)}
  to{opacity:1;transform:translateY(0) scale(1)}
}
.card:nth-of-type(2){animation-delay:.05s}
.card:nth-of-type(3){animation-delay:.1s}
.card:nth-of-type(4){animation-delay:.15s}
.btn{
  position:relative;overflow:hidden;transition:.2s transform,.2s box-shadow;
}
.btn:active{transform:scale(.985)}
.btn:before{
  content:"";position:absolute;top:0;left:-120%;width:70%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
  transform:skewX(-22deg);animation:shine 3.8s infinite;
}
@keyframes shine{0%,65%{left:-120%}100%{left:150%}}
.input{transition:.2s border-color,.2s box-shadow,.2s transform}
.input:focus{transform:translateY(-1px)}
.entry-switch{
  display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0 18px;
  background:#0d1116;border:1px solid var(--line);padding:6px;border-radius:20px;
}
.entry-switch button{
  border:0;border-radius:16px;padding:12px 10px;background:transparent;color:var(--muted);font-weight:800;
}
.entry-switch button.active{
  background:linear-gradient(180deg,#ff3038,#b90e19);color:#fff;box-shadow:0 5px 16px rgba(255,31,45,.28);
}
.entry-switch button{cursor:pointer;min-height:48px}
.entry-switch button:active{transform:scale(.98)}
.login-box{
  display:none;margin-bottom:14px;background:linear-gradient(160deg,#1d1114,#0e090b);
  border:1px solid var(--line);border-radius:26px;padding:16px;
}
.login-box.show{display:block;animation:cardIn .35s ease both}
.login-actions{display:grid;grid-template-columns:1fr auto;gap:10px}
.mini-btn{
  border:0;border-radius:18px;padding:0 17px;background:var(--blue);color:#fff;font-weight:900;
}
.welcome-client{
  display:none;margin-bottom:14px;padding:13px;border-radius:19px;
  background:rgba(255,31,45,.09);border:1px solid rgba(255,31,45,.28);color:#ffc1c6;
}
.welcome-client.show{display:block}
.locked-note{
  font-size:11.5px;color:#8f99a7;line-height:1.5;margin-top:8px;
}
.fade-section{transition:.25s opacity,.25s transform}
.fade-section.is-loading{opacity:.45;transform:scale(.995);pointer-events:none}


.customer-compact{
  display:none;align-items:center;gap:13px;
  border-color:rgba(255,31,45,.30);
  background:linear-gradient(145deg,rgba(255,31,45,.10),#140c0e 45%);
}
.customer-compact.show{display:flex;animation:cardIn .35s ease both}
.customer-photo-wrap{
  width:58px;height:58px;border-radius:50%;position:relative;flex:none;
  overflow:hidden;border:2px solid rgba(34,197,94,.55);
  box-shadow:0 8px 22px rgba(255,31,45,.20);
  background:linear-gradient(145deg,#69ef9c,#22c55e);
}
.customer-photo-wrap img{
  width:100%;height:100%;object-fit:cover;display:none;
}
.customer-photo-wrap img.show{display:block}
.customer-icon{
  width:100%;height:100%;border-radius:50%;display:grid;place-items:center;
  font-size:21px;font-weight:900;color:#07130b;
  background:linear-gradient(145deg,#69ef9c,#22c55e);
}
.customer-photo-wrap.has-photo .customer-icon{display:none}
.compact-label{font-size:10px;font-weight:900;letter-spacing:.7px;color:#ff8f98}
.compact-name{font-size:17px;font-weight:900;margin-top:3px}
.compact-cpf{font-size:12px;color:var(--muted);margin-top:3px}
#personalDataCard.hidden-login{display:none}
.login-box .saved-cpf{
  margin-top:10px;font-size:11.5px;color:#88a0bd;display:none
}
.login-box .saved-cpf.show{display:block}


.input.input-error{
  border-color:var(--red)!important;
  box-shadow:0 0 0 4px rgba(239,68,68,.13)!important;
  color:#ffb2b2;
}
.cpf-exists-alert{
  display:none;margin-top:9px;padding:11px 12px;border-radius:12px;
  background:rgba(239,68,68,.10);border:1px solid rgba(239,68,68,.35);
  color:#ffc0c0;font-size:12px;line-height:1.4;
}
.cpf-exists-alert.show{display:block;animation:cardIn .25s ease both}
.cpf-exists-alert strong,.cpf-exists-alert span{display:block}
.cpf-exists-alert button{
  margin-top:9px;border:0;border-radius:15px;padding:9px 12px;
  background:var(--red);color:white;font-weight:900;font-size:11px;
}


.client-back-btn{
  position:absolute;
  top:12px;
  left:12px;
  z-index:50;
  display:none;
  align-items:center;
  justify-content:center;
  gap:8px;
  min-width:118px;
  height:48px;
  padding:0 16px;
  border:1px solid var(--line);
  background:rgba(13,17,22,.94);
  backdrop-filter:blur(12px);
  color:#fff;
  border-radius:18px;
  font-weight:900;
  line-height:1;
  box-shadow:0 8px 22px rgba(0,0,0,.28);
  transition:.18s transform,.18s opacity;
}
.client-back-btn.show{display:flex}
.client-back-btn:active{transform:scale(.96)}
.client-back-btn span{font-size:12px}
.pix-needs-type{
  border-color:var(--gold)!important;
  box-shadow:0 0 0 4px rgba(244,183,64,.13)!important;
}
.pix-type-note{
  display:none;margin-top:7px;color:#e8c86f;font-size:11.5px;font-weight:700;
}
.pix-type-note.show{display:block}

#requestCard,#confirmationCard{display:none}
.register-consent{margin-top:8px}
.step-note{
  margin-top:10px;padding:11px 12px;border-radius:18px;
  border:1px solid rgba(255,31,45,.28);background:rgba(34,197,94,.08);
  color:#ffc1c6;font-size:12px;line-height:1.45
}

.cooldown-card{
  display:none;align-items:center;gap:13px;
  border-color:rgba(255,31,45,.34);
  background:linear-gradient(145deg,rgba(255,31,45,.11),#140c0e 48%);
}
.cooldown-card.show{display:flex;animation:cardIn .35s ease both}
.cooldown-icon{
  width:auto;height:auto;min-width:0;border-radius:16px;display:grid;place-items:center;
  flex:1;background:transparent;font-size:16px;
}
.cooldown-title{font-size:14px;font-weight:900;color:#f6d275}
.cooldown-text{font-size:11.5px;color:var(--muted);margin-top:3px}
.cooldown-time{font-size:25px;font-weight:900;color:#fff;margin-top:4px;letter-spacing:1px}
.cooldown-locked{opacity:.45;pointer-events:none;filter:grayscale(.15)}
</style>
</head>
<body>
<button class="client-back-btn" id="clientBackBtn" type="button" aria-label="Voltar"><span class="back-arrow">←</span><span>Voltar</span></button>
<main>
<section class="brand"><img src="data:image/png;base64," alt="NX Empréstimos" class="brand-logo"><h1>Solicitação de empréstimo</h1><p>Preencha seus dados para análise.</p><div class="hero-note">Simule seu valor, envie a solicitação e acompanhe a análise com segurança.</div><div class="progress"><span class="on"></span><span class="on"></span><span class="on"></span></div></section>
<section class="card" id="accessCard">
<h2 class="title">Como deseja continuar?</h2>
<p class="sub">Faça um novo cadastro ou acesse seus dados pelo CPF.</p>
<div class="entry-switch">
  <button type="button" id="modeNew" class="active">Novo cadastro</button>
  <button type="button" id="modeLogin">Já sou cliente</button>
</div>
<div class="login-box" id="loginBox">
  <div class="field" style="margin-bottom:0">
    <label>CPF CADASTRADO</label>
    <div class="login-actions">
      <input class="input" id="loginCpf" type="tel" inputmode="numeric" pattern="[0-9.\-]*" maxlength="14" autocomplete="off" placeholder="Digite os 11 números">
      <button class="mini-btn" type="button" id="loginBtn">ENTRAR</button>
    </div>
    <div class="locked-note">Digite o CPF usado no primeiro cadastro. Depois do acesso, aparecerá somente seu nome, chave PIX e valor.</div><div class="saved-cpf" id="savedCpfHint"></div>
  </div>
</div>
<div class="welcome-client" id="welcomeClient"></div>
</section>

<form id="form" class="fade-section" novalidate>

<section class="card cooldown-card" id="cooldownCard">
  <div class="cooldown-icon">⏳</div>
  <div class="grow">
    <div class="cooldown-title">Aguarde para fazer outra solicitação</div>
    <div class="cooldown-text">Você poderá solicitar novamente em:</div>
    <div class="cooldown-time" id="cooldownTime">01:00:00</div>
  </div>
</section>

<section class="card customer-compact" id="customerCompact">
  <div class="customer-photo-wrap">
    <img id="customerPhoto" alt="Foto do cliente">
    <div class="customer-icon" id="customerInitial">N</div>
  </div>
  <div class="grow">
    <div class="compact-label">CLIENTE IDENTIFICADO</div>
    <div class="compact-name" id="compactName">Cliente</div>
    <div class="compact-cpf" id="compactCpf"></div>
  </div>
</section>

<section class="card" id="personalDataCard">
<h2 class="title">Seus dados</h2><p class="sub">Informe os dados corretamente.</p>
<div class="field"><label>NOME COMPLETO</label><input class="input" id="name" required placeholder="Digite seu nome completo" style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase()" ></div>
<div class="grid">
<div class="field"><label>WHATSAPP</label><input class="input" id="phone" required type="tel" inputmode="tel" placeholder="(00) 00000-0000" maxlength="15"></div>
<div class="field"><label>CPF</label><input class="input" id="cpf" required type="tel" inputmode="numeric" pattern="[0-9.\-]*" autocomplete="off" placeholder="000.000.000-00" maxlength="14">
<div id="cpfExistsAlert" class="cpf-exists-alert">
  <strong>Este CPF já possui conta.</strong>
  <span>Toque em “Já sou cliente” e depois em “ENTRAR”.</span>
  <button type="button" id="goToLoginBtn">IR PARA ENTRAR</button>
</div></div>
</div>
<div class="grid">
<div class="field"><label>E-MAIL</label><input class="input" id="email" type="email" placeholder="email@exemplo.com"></div>
<div class="field"><label>ENDEREÇO COMPLETO</label><input class="input" id="address" required placeholder="Rua, número, bairro e cidade"></div>

<div class="register-consent">
  <label class="check">
    <input id="registerConsent" type="checkbox">
    <span>Autorizo o cadastro e o armazenamento dos meus dados. Declaro que as informações são verdadeiras.</span>
  </label>
</div>

</section>

<section class="card" id="requestCard">
<h2 class="title">Valor solicitado</h2>
<div class="field money-wrap">
<label>VALOR ENTRE R$ 50,00 E R$ 300,00</label>
<div class="money-input-shell">
  <span class="money-prefix">R$</span>
  <input class="input" id="amount" required inputmode="decimal" autocomplete="off" placeholder="0,00">
</div>
</div>
<div class="grid">
  <div class="field">
    <label>CHAVE PIX</label>
    <input class="input" id="pix" required placeholder="Digite sua chave PIX"><div class="pix-type-note" id="pixTypeNote">Escolha primeiro o tipo da chave PIX.</div>
  </div>
  <div class="field">
    <label>TIPO DA CHAVE PIX</label>
    <select class="input" id="pixType" required>
      <option value="">Selecione</option>
      <option>CPF</option>
      <option>Telefone</option>
      <option>E-mail</option>
      <option>Chave aleatória</option>
    </select>
  </div>
</div>
<div class="calc">
<div class="calc-box"><span>JUROS APLICADOS</span><strong class="gold" id="rate">0%</strong></div>
<div class="calc-box"><span>VALOR DOS JUROS</span><strong id="interest">R$ 0,00</strong></div>
<div class="calc-box" style="grid-column:1/-1"><span>TOTAL A PAGAR</span><strong class="green" id="total">R$ 0,00</strong></div>
</div>
<div class="rate-info" id="rateInfo">Digite um valor entre R$ 50,00 e R$ 300,00.</div>
</section>

<section class="card" id="confirmationCard">
<h2 class="title">Confirmação da solicitação</h2>
<p class="sub">Confira os dados e aceite os termos antes de enviar.</p>
<div class="summary-box">
  <div><span>Valor solicitado</span><strong id="summaryAmount">R$ 0,00</strong></div>
  <div><span>Juros aplicados</span><strong id="summaryRate">0%</strong></div>
  <div><span>Total previsto</span><strong class="green" id="summaryTotal">R$ 0,00</strong></div>
</div>
<label class="check"><input id="consent" type="checkbox" required><span>Autorizo o envio e armazenamento dos meus dados para análise desta solicitação. Declaro que as informações são verdadeiras.</span></label>
</section>

<button class="btn" id="submit" type="submit">FINALIZAR CADASTRO</button>
<div class="security"><i>🔒</i><span>Seus dados são enviados com conexão segura e usados somente para análise.</span></div><p class="notice">O envio não garante aprovação. A solicitação será analisada antes da liberação.</p>
</form>

<section class="card success" id="success"><div class="ok">✓</div><h2 id="successTitle">Solicitação enviada</h2><p id="protocolText" class="sub"></p></section>
</main>
<div class="toast" id="toast"></div>

